<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.newshot.online-refresh</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/wangyajing/skills/新闻/TrendRadar/tools/refresh_cloud_agent.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/wangyajing/skills/新闻/TrendRadar</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>TZ</key><string>Asia/Shanghai</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>20</integer>
  <key>StandardOutPath</key><string>/Users/wangyajing/skills/新闻/TrendRadar/.local-refresh/online/agent.log</string>
  <key>StandardErrorPath</key><string>/Users/wangyajing/skills/新闻/TrendRadar/.local-refresh/online/agent.err.log</string>
</dict></plist>
